<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Imagen de fondo fija -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.10"
        android:src="@drawable/ic_launcher_background" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="56dp"
            tools:context=".RegistrarExpedicionActivity">

            <!--  Titulo  -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_registro"
                android:textColor="@color/primary_blue"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!--  Ubicacion  -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUbicacion"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:hint="@string/hint_ubicacion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_dark" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--  Presupuesto  -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPresupuesto"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/hint_presupuesto"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tilUbicacion">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPresupuesto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_dark" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--  Titulo categoria  -->
            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_categoria"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tilPresupuesto" />

            <!--  Spinner categorias styled with background -->
            <FrameLayout
                android:id="@+id/spinnerContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/spinner_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCategoria">

                <Spinner
                    android:id="@+id/spinnerCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/array_categorias_riesgo"
                    android:theme="@style/SpinnerTemaOscuro" />
            </FrameLayout>

            <!--  Titulo transportes  -->
            <TextView
                android:id="@+id/tvTransporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_transporte"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/spinnerContainer" />

            <!--  Opciones de Transporte  -->
            <RadioGroup
                android:id="@+id/rgTransporte"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvTransporte">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb4x4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transporte_4x4"
                    android:textColor="@color/text_dark" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbAereo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transporte_aereo"
                    android:textColor="@color/text_dark" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbPie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/transporte_pie"
                    android:textColor="@color/text_dark" />
            </RadioGroup>

            <!--  Emociones -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmociones"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/hint_emociones"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rgTransporte">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmociones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:textColor="@color/text_dark" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--  Opciones de emociones (Switch Material)  -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/tbEpico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/toggle_epico_off"
                android:textColor="@color/text_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tilEmociones" />

            <!--  Guardado  -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="@string/btn_guardar"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tbEpico" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>